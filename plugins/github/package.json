{
  "name": "@ivin/plugin-github",
  "version": "0.0.0",
  "private": true,
  "peerDependencies": {
    "@ivin/plugin-api": "^0"
  },
  "ivin": {
    "id": "github",
    "name": "GitHub",
    "server": "src/server.ts",
    "ui": "src/ui.tsx",
    "permissions": {
      "exec": [
        "gh",
        "git"
      ],
      "harness": [
        "beforeSpawn"
      ]
    }
  }
}
