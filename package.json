{
  "name": "ivin",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "vp lint -c .oxlintrc.json --deny-warnings && stylelint --max-warnings 0 'packages/ui/src/**/*.css'",
    "format": "vp fmt -c .oxfmtrc.json",
    "format:check": "vp fmt --check -c .oxfmtrc.json",
    "typecheck": "vp run --filter './apps/*' --filter './packages/*' typecheck && tsc --noEmit",
    "test": "vp test run",
    "test:repeat-changed": "node tools/repeat-changed-tests/main.ts",
    "record:claude": "node tools/record-claude-fixture/main.ts",
    "build": "vp run --filter './apps/*' --filter './packages/*' build",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test",
    "dev": "vp run --filter @ivin/server --filter @ivin/cli build && vp run --parallel --filter @ivin/ui --filter @ivin/desktop dev",
    "package": "pnpm build && pnpm --filter @ivin/desktop package",
    "install-app": "node apps/desktop/scripts/install-app.ts",
    "e2e": "pnpm --filter @ivin/desktop e2e"
  },
  "devDependencies": {
    "@ivin/plugin-api": "workspace:*",
    "@release-it/conventional-changelog": "^12.0.2",
    "@types/node": "^26.6.6",
    "@types/react": "^19",
    "conventional-changelog-conventionalcommits": "^10.4.1",
    "react": "19.3.1",
    "release-it": "^21.1.3",
    "stylelint": "^18.1.0",
    "typescript": "^7.0.2",
    "typescript-compiler-api": "npm:typescript@^5.9.0",
    "vite": "npm:@voidzero-dev/vite-plus-core@8.3.8000",
    "vite-plus": "1.7.0",
    "vitest": "5.1.1",
    "vitest-browser-react": "^2.3.0"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "packageManager": "pnpm@12.21.0"
}
