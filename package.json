{
  "name": "ivin",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "vp lint -c .oxlintrc.json --deny-warnings",
    "format": "vp fmt -c .oxfmtrc.json",
    "format:check": "vp fmt --check -c .oxfmtrc.json",
    "typecheck": "pnpm -r typecheck && tsc --noEmit",
    "test": "vp test run",
    "build": "pnpm -r --if-present build",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "typescript": "^5.9.0",
    "vite-plus": "1.7.0"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "packageManager": "pnpm@9.15.0",
  "pnpm": {
    "overrides": {
      "effect": "4.1.4"
    }
  }
}
